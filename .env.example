# Copie este arquivo para .env.local (no PC) ou cadastre as variáveis na Vercel.

# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=cole-aqui-a-chave-anon-ou-publishable

# Opcional: número do WhatsApp da CMR só com dígitos (55 + DDD + número)
NEXT_PUBLIC_WHATSAPP=

# Opcional: endereço público do site (ex.: https://catalogo-cmr.vercel.app)
NEXT_PUBLIC_SITE_URL=
